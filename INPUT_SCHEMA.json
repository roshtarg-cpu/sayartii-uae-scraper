{
  "title": "Input schema for Sayartii UAE Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "carType": {
      "title": "Car Type",
      "type": "string",
      "description": "Vehicle body type",
      "default": "",
      "enum": ["", "sedan", "suv", "coupe", "hatch", "pickup", "wagon", "minivan"],
      "enumTitles": ["All Types", "Sedan", "SUV", "Coupe", "Hatchback", "Pickup", "Wagon", "Minivan"]
    },
    "brand": {
      "title": "Brand",
      "type": "string",
      "description": "Car manufacturer",
      "default": "",
      "editor": "textfield"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum cars to extract",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Apify proxy settings",
      "editor": "proxy",
      "default": { "useApifyProxy": true }
    }
  },
  "required": []
}
